## DMA engines
# removed stale make refs from snd-soc-dma-sh7760-y
obj-$(CONFIG_SND_SOC_PCM_SH7760)	+= snd-soc-dma-sh7760.o

## audio units found on some SH-4
# removed stale make refs from snd-soc-hac-y
# removed stale make refs from snd-soc-ssi-y
# removed stale make refs from snd-soc-fsi-y
# removed stale make refs from snd-soc-siu-y
obj-$(CONFIG_SND_SOC_SH4_HAC)	+= snd-soc-hac.o
obj-$(CONFIG_SND_SOC_SH4_SSI)	+= snd-soc-ssi.o
obj-$(CONFIG_SND_SOC_SH4_FSI)	+= snd-soc-fsi.o
obj-$(CONFIG_SND_SOC_SH4_SIU)	+= snd-soc-siu.o

## audio units for R-Car
obj-$(CONFIG_SND_SOC_RCAR)	+= rcar/

## boards
# removed stale make refs from snd-soc-sh7760-ac97-y
# removed stale make refs from snd-soc-migor-y

obj-$(CONFIG_SND_SH7760_AC97)	+= snd-soc-sh7760-ac97.o
obj-$(CONFIG_SND_SIU_MIGOR)	+= snd-soc-migor.o

# RZ/G2L
snd-soc-rz-ssi-y		:= rz-ssi.o
obj-$(CONFIG_SND_SOC_RZ)	+= snd-soc-rz-ssi.o
